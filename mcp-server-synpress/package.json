{
  "name": "@synthetixio/synpress-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Synpress - enables AI models to perform browser automation, wallet management, and crypto operations",
  "type": "module",
  "bin": {
    "synpress-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "synpress",
    "metamask",
    "wallet",
    "crypto",
    "blockchain",
    "ethereum",
    "browser-automation",
    "playwright",
    "testing",
    "e2e"
  ],
  "author": "Synthetix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Synthetixio/synpress.git",
    "directory": "mcp-server-synpress"
  },
  "homepage": "https://synpress.io",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@synthetixio/synpress-cache": "workspace:*",
    "@synthetixio/synpress-core": "workspace:*",
    "@synthetixio/synpress-metamask": "workspace:*",
    "playwright": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
